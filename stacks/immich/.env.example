# Immich application and database data remain on the mini PC.
UPLOAD_LOCATION=${DATA_ROOT}/immich/library
DB_DATA_LOCATION=${DATA_ROOT}/immich/postgres
DATA_ROOT=/mnt/home-server-data

IMMICH_VERSION=release

DB_USERNAME=immich
DB_PASSWORD=
DB_DATABASE_NAME=immich

# Deployment settings. These may be inherited from shared/.env.
SHARED_NETWORK=home-server
IMMICH_HOST_PORT=2283
PRIMARY_USER=your_username

# The external Photos library is derived as:
# NEXTCLOUD_DATA_PATH/PRIMARY_USER/files/Photos
NEXTCLOUD_DATA_PATH=/mnt/nas/nextcloud/data
