# Container identity and deployment settings.
PUID=1000
PGID=1000
TZ=Asia/Singapore
LOCAL_IP=192.168.1.10
SHARED_NETWORK=home-server

# The migrated media/download library is on the NAS. Do not use /mnt/media.
MEDIA_ROOT=/mnt/nas/data

# Host-facing ports. These may instead be inherited from shared/.env.
QBITTORRENT_HOST_PORT=8091
QBITTORRENT_INTERNAL_PORT=8080
RADARR_HOST_PORT=7878
SONARR_HOST_PORT=7879
PROWLARR_HOST_PORT=7880
BAZARR_HOST_PORT=7881

# Proton VPN credentials and server selection.
# Leave the private key blank while the subscription is inactive.
WIREGUARD_PRIVATE_KEY=
VPN_SERVER_COUNTRIES=Singapore
