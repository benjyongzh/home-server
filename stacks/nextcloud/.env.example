# PostgreSQL application connection.
POSTGRES_HOST=postgres
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=

# Nextcloud-local Redis authentication.
REDIS_PASSWORD=

# Initial administrator password. PRIMARY_USER supplies the admin username.
NEXTCLOUD_ADMIN_PASSWORD=

# Host and local-domain settings. These may be inherited from shared/.env.
TZ=Asia/Singapore
LOCAL_IP=192.168.1.10
TAILSCALE_IP=
LOCAL_HOSTNAME=home-server
LOCAL_DOMAIN=home.arpa
SHARED_NETWORK=home-server
PRIMARY_USER=your_username
NEXTCLOUD_HOST_PORT=8081

# DATA_ROOT is retained for other VM-local storage conventions. Nextcloud user
# data now lives on the NAS at NEXTCLOUD_DATA_PATH.
DATA_ROOT=/srv
NEXTCLOUD_DATA_PATH=/mnt/nas/nextcloud/data
NEXTCLOUD_DB_BACKUP_DIR=/mnt/nas/backups/nextcloud-db
