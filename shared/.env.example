# Machine identity
LOCAL_SCHEME=http
LOCAL_IP=192.168.1.10
LOCAL_DOMAIN=home.arpa
LOCAL_HOSTNAME=home-server
TAILSCALE_IP=

# Primary host user
PRIMARY_USER=your_username
PRIMARY_EMAIL=user@example.com
PUID=1000
PGID=1000

# Host-wide defaults
TZ=Etc/UTC
INSTALL_ROOT=/opt
STACKS_ROOT=${INSTALL_ROOT}/stacks
DATA_ROOT=/mnt/home-server-data
MEDIA_ROOT=/mnt/nas/data
SHARED_NETWORK=home-server
NEXTCLOUD_DATA_PATH=/mnt/nas/nextcloud/data
NEXTCLOUD_DB_BACKUP_DIR=/mnt/nas/backups/nextcloud-db

# UGREEN NAS integration. These document the host-wide mount layout; the
# fstab and mount-check copies under infra/ are the runtime configuration.
NAS_HOST=192.168.0.220
NAS_DATA_ROOT=/mnt/nas/data
NAS_NEXTCLOUD_ROOT=/mnt/nas/nextcloud
NAS_BACKUP_ROOT=/mnt/nas/backups

# Host port allocation
ADGUARD_DNS_PORT=53
ADGUARD_WEB_PORT=8080
BESZEL_AGENT_LISTEN_PORT=45876
BESZEL_HOST_PORT=8090
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
DOCKGE_HOST_PORT=5001
HOMEPAGE_HOST_PORT=3000
IMMICH_HOST_PORT=2283
JELLYFIN_HOST_PORT=8096
NEXTCLOUD_HOST_PORT=8081
POSTGRES_HOST_PORT=5432
QBITTORRENT_HOST_PORT=8091
RADARR_HOST_PORT=7878
SONARR_HOST_PORT=7879
PROWLARR_HOST_PORT=7880
BAZARR_HOST_PORT=7881
