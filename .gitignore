###############################################################################
# Application runtime configuration/state
###############################################################################

# Torrent applications store databases, API keys, logs and runtime state here
/stacks/torrent/config/

# Gluetun runtime state may contain VPN-related data
/stacks/torrent/gluetun/

# Application-managed data directories anywhere below stacks
/stacks/**/data/
/stacks/**/database/
/stacks/**/databases/
/stacks/**/db/
/stacks/**/cache/
/stacks/**/logs/
/stacks/**/log/
/stacks/**/backup/
/stacks/**/backups/
/stacks/**/migration-backup*/
/stacks/**/tmp/
/stacks/**/temp/

